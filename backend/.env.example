# MediScan Backend Environment Variables
# Copy this file to .env and fill in your values

# Security
ENVIRONMENT=development
PORT=8000
SECRET_KEY=replace-with-a-unique-32-plus-character-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq (for MediBot AI)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Nutritionix (optional fallback product data)
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
