# MediScan Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mediscan

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI (for MediBot)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Nutritionix (optional fallback product data)
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
